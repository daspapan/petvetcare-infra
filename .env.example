# Deployment environment (dev | staging | prod)
CDK_ENV=dev

# AWS account and region
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# Route 53 hosted zone for petvetcare.app (leave empty to create a new zone)
HOSTED_ZONE_ID=

# Cognito social / enterprise IdP credentials (set before deploying AuthStack)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Google Calendar integration (stored in Secrets Manager by ApiStack)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.petvetcare.app/integrations/google/callback

# CORS origins (comma-separated)
WEB_APP_ORIGIN=https://app.petvetcare.app
MOBILE_APP_ORIGIN=*
