# Deployment environment (dev | staging | prod)
CDK_ENV=dev

# AWS account and region (primary stack region — e.g. ap-south-1)
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=ap-south-1

# REQUIRED: Existing Route 53 hosted zone (never creates a new zone)
HOSTED_ZONE_ID=

# REQUIRED: ACM certificate in us-east-1 for CloudFront
# Must include cdn.{env}.petvetcare.app (or your PUBLIC_ASSET_CDN_DOMAIN)
ACM_CERTIFICATE_ARN=

# Optional: Regional ACM cert for API Gateway custom domain (same region as CDK_DEFAULT_REGION)
# API_CERTIFICATE_ARN=arn:aws:acm:ap-south-1:919620897356:certificate/xxxxxxxx

# Domain configuration
DOMAIN_NAME=petvetcare.app
API_SUBDOMAIN=api.dev
PUBLIC_ASSET_CDN_DOMAIN=cdn.dev.petvetcare.app

# Set true only if CDK should create Route53 alias records in the imported zone
CREATE_DNS_RECORDS=false

# Cognito social / enterprise IdP credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# SES sender for OTP emails
SES_FROM_EMAIL=noreply@petvetcare.app

# CORS origins
WEB_APP_ORIGIN=https://app.dev.petvetcare.app
MOBILE_APP_ORIGIN=*

# Aurora scaling
AURORA_MIN_ACU=0.5
AURORA_MAX_ACU=4
AURORA_DATABASE_NAME=petvetcare
